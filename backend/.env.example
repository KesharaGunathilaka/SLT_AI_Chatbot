# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/slt_chatbot

# Zilliz Cloud / Milvus Configuration
ZILLIZ_CLOUD_URI=https://your-cluster.zillizcloud.com:port
ZILLIZ_CLOUD_API_KEY=your_zilliz_api_key_here
VECTOR_COLLECTION=slt_content

# Embedding Model Configuration
# Model: BAAI/bge-m3 (1024 dim) or sentence-transformers/all-mpnet-base-v2 (768 dim)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBED_QUERY_PREFIX=

# Retrieval Configuration
SEARCH_TOP_K=20                      # Number of results to retrieve before reranking
CONTEXT_CHUNKS=4                     # Number of chunks to send to LLM
SCORE_THRESHOLD_IP=0.2               # Minimum similarity score (for IP metric)
PRIORITY_BONUS=0.001                 # Bonus per priority point
RECENCY_BONUS_HALF_LIFE_DAYS=90      # Decay for older content
ENABLE_RERANK=true                   # Enable cross-encoder reranking
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM Provider Configuration
# Get your Groq API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Application Settings
EMBED_BATCH=32                       # Batch size for embedding generation

# Optional: Local LLM Settings (if using Ollama or LM Studio)
# Ollama runs on http://127.0.0.1:11434 by default
# LM Studio runs on http://127.0.0.1:1234 by default
