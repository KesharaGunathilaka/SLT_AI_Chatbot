# .env.example
# Copy this file to `.env` and fill values #


# PostgreSQL Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/slt_chatbot

# Vector Database - Zilliz Cloud / Milvus Configuration
ZILLIZ_CLOUD_URI=https://your-cluster.zillizcloud.com:port # For Local Milvus, use MILVUS_URI=milvus://localhost:19530
ZILLIZ_CLOUD_API_KEY=your_zilliz_api_key_here
VECTOR_COLLECTION=SLT_AI

# Embedding Model Configuration
# Choose one: BAAI/bge-base-en-v1.5 (768 dim) or sentence-transformers/all-mpnet-base-v2 (768 dim)
EMBEDDING_MODEL = BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
EMBED_BATCH = 64
# Optional: used only if your pipeline prepends a query prefix for embeddings
# EMBED_QUERY_PREFIX=

# Retrieval Configuration
SEARCH_TOP_K=50                      # Number of results to retrieve before reranking
CONTEXT_CHUNKS=5                     # Number of chunks to send to LLM
SCORE_THRESHOLD_IP=0.3               # Minimum similarity score (for IP metric)

# Metadata-based Relevance Boosting
PRIORITY_BONUS=0.001                 # Bonus per priority point
RECENCY_BONUS=0.05                   # Base weight for recency bonus
RECENCY_BONUS_HALF_LIFE_DAYS=60      # Decay half-life for older content (days)

# Multi-Query Expansion (MQE) Configuration
ENABLE_MQE=true                      # Enable multi-query expansion
MQE_QUERIES=2                        # Number of additional queries for MQE

# Reranking Configuration
ENABLE_RERANK=true                   # Enable reranking
# Choose one: BAAI/bge-reranker-base or cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=20                      # Number of candidates to rerank

# Cloud LLM Model GROQ
# Get your Groq API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
# Optional backup key if primary is rate limited or rotated
GROQ_API_KEY_BACKUP=your_groq_api_key_here


# Optional: Local LLM Settings (if using Ollama or LM Studio)
# Ollama runs on http://127.0.0.1:11434 by default
# LM Studio runs on http://127.0.0.1:1234 by default
